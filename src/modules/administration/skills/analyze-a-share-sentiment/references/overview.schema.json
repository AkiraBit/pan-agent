{
  "$defs": {
    "Axis": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "improving",
            "stable",
            "deteriorating",
            "mixed",
            "insufficient"
          ],
          "title": "State",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "state",
        "explanation",
        "evidence_ids"
      ],
      "title": "Axis",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "DecisionBoundary": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "strengthens": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Strengthens",
          "type": "string"
        },
        "invalidates": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Invalidates",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "strengthens",
        "invalidates"
      ],
      "title": "DecisionBoundary",
      "type": "object"
    },
    "DecisionPage": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "rhythm": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Rhythm",
          "type": "string"
        },
        "assessment": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "cycle_note": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Cycle Note",
          "type": "string"
        },
        "short_term": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Short Term",
          "type": "string"
        },
        "index_context": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Index Context",
          "type": "string"
        },
        "structure": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Structure",
          "type": "string"
        },
        "theme_verdict": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Theme Verdict",
          "type": "string"
        },
        "today_strategy": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Today Strategy",
          "type": "string"
        },
        "buy_point_verdict": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Buy Point Verdict",
          "type": "string"
        },
        "tomorrow_title": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Tomorrow Title",
          "type": "string"
        },
        "tomorrow_expectation": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Tomorrow Expectation",
          "type": "string"
        },
        "boundaries": {
          "items": {
            "$ref": "#/$defs/DecisionBoundary"
          },
          "maxItems": 6,
          "minItems": 3,
          "title": "Boundaries",
          "type": "array"
        },
        "actions": {
          "items": {
            "maxLength": 2400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Actions",
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/DecisionPath"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Paths",
          "type": "array"
        }
      },
      "required": [
        "confidence",
        "rhythm",
        "assessment",
        "cycle_note",
        "short_term",
        "index_context",
        "structure",
        "theme_verdict",
        "today_strategy",
        "buy_point_verdict",
        "tomorrow_title",
        "tomorrow_expectation",
        "boundaries",
        "actions",
        "paths"
      ],
      "title": "DecisionPage",
      "type": "object"
    },
    "DecisionPath": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Side",
          "type": "string"
        },
        "title": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trigger": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        },
        "invalidation": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Invalidation",
          "type": "string"
        },
        "action": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "sectors": {
          "items": {
            "maxLength": 2400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Sectors",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/FocusStock"
          },
          "maxItems": 3,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "side",
        "title",
        "trigger",
        "invalidation",
        "action",
        "sectors",
        "candidates"
      ],
      "title": "DecisionPath",
      "type": "object"
    },
    "EvidenceGroup": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "enum": [
            "G",
            "A",
            "P",
            "R"
          ],
          "title": "Group",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "proxy",
            "missing",
            "conflicted"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "group",
        "status",
        "explanation",
        "evidence_ids"
      ],
      "title": "EvidenceGroup",
      "type": "object"
    },
    "FocusStock": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "name": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "reason": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "trigger": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        },
        "invalidation": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Invalidation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "name",
        "role",
        "reason",
        "trigger",
        "invalidation",
        "evidence_ids"
      ],
      "title": "FocusStock",
      "type": "object"
    },
    "NextCheck": {
      "additionalProperties": false,
      "properties": {
        "window": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        },
        "observe": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Observe",
          "type": "string"
        },
        "strengthens": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Strengthens",
          "type": "string"
        },
        "invalidates": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Invalidates",
          "type": "string"
        },
        "verification_window": {
          "default": "qualitative",
          "enum": [
            "qualitative",
            "next_session_close"
          ],
          "title": "Verification Window",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "invalidation_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "window",
        "observe",
        "strengthens",
        "invalidates"
      ],
      "title": "NextCheck",
      "type": "object"
    },
    "ObservationRule": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "positive_ratio",
            "median",
            "p10",
            "feedback_mean"
          ],
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "basis": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "calibration": {
          "const": "unvalidated",
          "default": "unvalidated",
          "title": "Calibration",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "operator",
        "value",
        "basis"
      ],
      "title": "ObservationRule",
      "type": "object"
    },
    "StagePosition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stage",
            "between",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "stages": {
          "items": {
            "enum": [
              "ice",
              "repair",
              "expansion",
              "heat",
              "divergence",
              "retreat"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Stages",
          "type": "array"
        },
        "status": {
          "enum": [
            "candidate",
            "supported",
            "conflicted",
            "insufficient"
          ],
          "title": "Status",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "stages",
        "status",
        "rationale",
        "evidence_ids"
      ],
      "title": "StagePosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "maxLength": 2400,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "maxLength": 2400,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "direction": {
      "enum": [
        "improving",
        "stable",
        "deteriorating",
        "mixed",
        "insufficient"
      ],
      "title": "Direction",
      "type": "string"
    },
    "direction_reason": {
      "maxLength": 2400,
      "minLength": 1,
      "title": "Direction Reason",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/StagePosition"
    },
    "loss_relief": {
      "$ref": "#/$defs/Axis"
    },
    "profit_diffusion": {
      "$ref": "#/$defs/Axis"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/EvidenceGroup"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Groups",
      "type": "array"
    },
    "supports": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Supports",
      "type": "array"
    },
    "counters": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Counters",
      "type": "array"
    },
    "next_checks": {
      "items": {
        "$ref": "#/$defs/NextCheck"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Next Checks",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2400,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionPage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "title",
    "summary",
    "direction",
    "direction_reason",
    "stage",
    "loss_relief",
    "profit_diffusion",
    "groups",
    "supports",
    "counters",
    "next_checks",
    "limitations"
  ],
  "title": "OverviewAnalysis",
  "type": "object"
}
